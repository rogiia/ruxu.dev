---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all %}
{%- if entry.data.sitemap != false and entry.url and entry.url != '/404.html' and entry.url != '/sitemap.xml' and entry.url != '/feed.xml' %}
  <url>
    <loc>{{ entry.url | absoluteSiteUrl }}</loc>
    {%- if entry.data.tags and 'post' in entry.data.tags %}
    <lastmod>{{ (entry.data.modified or entry.date) | htmlDateString }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
