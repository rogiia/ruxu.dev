<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  {%- set pageTitle = title + (' - Page ' + (pagination.pageNumber + 1) if (pagination and pagination.pageNumber > 0) else '') %}
  {%- set documentTitle = pageTitle if ("Roger Oriol" in pageTitle) else (pageTitle + " | " + site.name) %}
  <title>{{ documentTitle }}</title>

  <meta name="viewport"
    content="viewport-fit=cover, width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=5.0">
  {%- set pageUrl = page.url | absoluteSiteUrl %}
  {%- set pageImage = (image or site.defaultImage) | absoluteSiteUrl %}
  {%- set isArticlePage = (ogType == 'article') %}
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}
  <meta name="theme-color" content="#33d">
  <meta name="author" content="{{ site.author.name }}">

  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:type" content="{{ 'article' if isArticlePage else 'website' }}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:image" content="{{ pageImage }}" />
  {% if metaDescription %}<meta property="og:description" content="{{ metaDescription }}" />{% endif %}
  {% if isArticlePage %}
  <meta property="article:published_time" content="{{ date | htmlDateString }}" />
  <meta property="article:modified_time" content="{{ (modified or date) | htmlDateString }}" />
  <meta property="article:author" content="{{ site.author.url }}" />
  {% if category %}<meta property="article:section" content="{{category}}" />{% endif %}
  {%- for tag in tags %}{% if tag != 'post' and tag != 'article' and tag != 'link' and tag != 'project' %}
  <meta property="article:tag" content="{{ tag }}" />{% endif %}{% endfor %}
  {% endif %}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="{{ site.author.twitter }}" />
  <meta name="twitter:creator" content="{{ site.author.twitter }}" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  {% if metaDescription %}<meta name="twitter:description" content="{{ metaDescription }}" />{% endif %}
  <meta name="twitter:image" content="{{ pageImage }}" />

  <link rel="canonical" href="{{ pageUrl }}" />

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/firefox/firefox-general-32-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/chrome/chrome-favicon-16-16.png">
  <link rel="apple-touch-icon" sizes="192x192" href="/assets/icons/apple/apple-launchericon-192-192.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ 'feed.xml' | absoluteSiteUrl }}">
  <meta name="color-scheme" content="light dark">

  <link rel="preload" href="/assets/fonts/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>


  {% include "structured-data.njk" %}

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js');
      });
    }
  </script>

  {%- if '<pre class="language-' in content %}
  <style>{% prismCss %}</style>
  {%- endif %}
  <style>{% criticalCss %}</style>
  <link rel="preload" href="{% mainCssUrl %}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="{% mainCssUrl %}">
  </noscript>
</head>

<body>
  <div id="main-container">
    <header>
      <div>
        {%- set siteTitleTag = 'h1' if page.url == '/' else 'p' %}
        <a href="/">
          <{{ siteTitleTag }} class="site-title">Roger Oriol</{{ siteTitleTag }}>
        </a>
      </div>
      <div id="icons">
        <a target="_blank" rel="noopener" href="https://github.com/rogiia"><img src="/assets/icons/github.svg" title="Github"
            alt="Github" /></a>
        <a target="_blank" rel="noopener" href="/feed.xml"><img src="/assets/icons/rss.svg" title="RSS" alt="RSS" /></a>
        <a target="_blank" rel="noopener" href="https://x.com/rogiia"><img src="/assets/icons/x.svg" title="X (formerly Twitter)"
            alt="X" /></a>
        <a href="mailto:roger@ruxu.dev"><img src="/assets/icons/email.svg" title="Email" alt="Email" /></a>
      </div>
    </header>
    <main>
      {{ content | safe }}
    </main>
  </div>
</body>

</html>
